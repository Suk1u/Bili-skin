#!name=B站装扮工作室
#!desc=让哔哩哔哩 App 用上任意装扮（含付费、含已下架）。用法：在 App 里打开「我的 → 装扮」，页面右下角会出现「全部装扮」按钮，点开可浏览全部装扮并按分类/关键词筛选；点任意一套进入详情页，左上角会出现「应用此装扮」按钮，点一下即注入；杀掉后台重进 App 生效。注意：已下架的装扮 B站已不再下发图片包，只有你之前在能取到时存过才能用（应用过的会自动进「藏馆」）。
#!author=海鸥 (Surge)
#!category=哔哩哔哩
#!icon=paintbrush
#!system=ios
#!requirement=CORE_VERSION>=20

[Script]
# 1. H5 页面与 Surge 的通信桥：接管 /x/surge-skin/*，直接返回假响应，不发网络请求。
BiliSkinBridge = type=http-request,pattern=^https?:\/\/app\.bilibili\.com\/x\/surge-skin\/,requires-body=true,max-size=262144,timeout=5,script-path=https://raw.githubusercontent.com/Suk1u/Bili-skin/main/bili_skin.js,script-update-interval=86400

# 2. 应用装扮：把「当前装扮」换成注入的那套。
BiliSkinApply = type=http-response,pattern=^https?:\/\/app\.bilibili\.com\/x\/resource\/show\/skin(?:\?.*)?$,requires-body=true,max-size=1048576,timeout=10,script-path=https://raw.githubusercontent.com/Suk1u/Bili-skin/main/bili_skin.js,script-update-interval=86400

# 3. 注入页面脚本：装扮商城 / 详情页（www.bilibili.com/h5/mall/*）。
BiliSkinInject = type=http-response,pattern=^https?:\/\/www\.bilibili\.com\/h5\/mall\/,requires-body=true,max-size=2097152,timeout=10,script-path=https://raw.githubusercontent.com/Suk1u/Bili-skin/main/bili_skin.js,script-update-interval=86400

[MITM]
hostname = %APPEND% app.bilibili.com, www.bilibili.com
